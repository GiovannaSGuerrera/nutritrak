PORT=3000
NODE_ENV=development
APP_ORIGIN=http://localhost:3000
# Depois de aplicar migrações com uma conta administrativa:
# DB_AUTO_MIGRATE=false
# BACKUP_DATABASE_URL=conexao-com-permissao-somente-leitura
# RESTORE_DATABASE_URL=conexao-de-banco-vazio-isolado
# BACKUP_KEY=chave-de-32-bytes-em-base64-guardada-em-cofre
# DATABASE_URL=postgresql://nutritrack:senha@localhost:5432/nutritrack

# Hardening: produção exige migração explícita, origem HTTPS e relay autorizado.
DB_AUTO_MIGRATE=false
MAIL_ENCRYPTION_KEY=
# false permite operação sem envio; não comprova posse dos endereços cadastrados.
EMAIL_ENABLED=true
# false adia documentos; não representa conformidade jurídica.
LEGAL_DOCUMENTS_REQUIRED=true
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
# Operador fornece legal/privacy.md e terms.md aprovados; build empacota em dist/legal.
PRIVACY_POLICY_FILE=
TERMS_FILE=
# Opcional: executor existente chama GET /api/jobs/mail com Authorization: Bearer <CRON_SECRET>.
CRON_SECRET=
AUDIT_RETENTION_DAYS=90
# Somente CLI de migração, nunca no runtime da aplicação:
MIGRATION_DATABASE_URL=
# Somente ambiente de teste descartável, nome terminado em _test:
TEST_DATABASE_URL=
TEST_DATABASE_CONFIRM=
