APP_ENV=development
API_PORT=8000
POSTGRES_DB=nutritrack
POSTGRES_USER=nutritrack
POSTGRES_PASSWORD=replace-with-a-long-random-local-secret
SESSION_COOKIE_SECURE=false
SESSION_TTL_HOURS=8
CORS_ORIGINS=http://localhost:3000,http://localhost:8080

# Node production profile (one app instance, local persistent volume)
NODE_ENV=development
STORE_BACKEND=sqlite
DATA_DIR=./data
PUBLIC_ORIGIN=http://localhost:3000
# For production set DOMAIN and CORS_ORIGINS=https://your-domain
# Generate locally: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Never commit the generated key. Keep it in a secret manager/offline recovery copy.
MAIL_ENCRYPTION_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
DOMAIN=

# Production policy documents must be approved and supplied by the operator.
PRIVACY_POLICY_FILE=
TERMS_FILE=
# Separate offline-recovery key for encrypted backups (32-byte hex).
BACKUP_ENCRYPTION_KEY=
# Set to 1 only behind ONE trusted proxy with no public access to the app port.
TRUST_PROXY=0
AUDIT_RETENTION_DAYS=90
